/**
 * Rules for AssemblyScript code
 * These files contain performance-critical code compiled to WebAssembly
 */

match level/assemblyscript/**/*.ts {
  description: "
    This is an AssemblyScript file for the Get Lost level.
    
    AssemblyScript is used for performance-critical parts of the level code.
    It's compiled to WebAssembly for faster execution.
    
    Common uses:
    - Pathfinding algorithms
    - Physics calculations
    - Complex game logic
    
    Note: AssemblyScript is a subset of TypeScript designed for WebAssembly compilation.
    It has different constraints than regular TypeScript.
  "
}

match level/assemblyscript/**/*.json {
  description: "
    Configuration file for AssemblyScript compilation.
    
    This file configures how the AssemblyScript code is compiled to WebAssembly.
  "
} 