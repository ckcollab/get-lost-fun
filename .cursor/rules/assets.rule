/**
 * Rules for game assets
 * These files contain the art, sounds, and other resources for the Get Lost level
 */

match level/art/**/* {
  description: "
    This is an art asset for the Get Lost level.
    
    Art assets include:
    - Sprites and textures
    - Tilesets
    - Background images
    - Character designs
    
    The project uses the CC0 asset pack 'Ninja Adventure' from Pixel Boy.
  "
}

match level/sounds/**/* {
  description: "
    This is a sound asset for the Get Lost level.
    
    Sound assets include:
    - Background music
    - Sound effects
    - Voice lines
    
    Audio files should be properly attributed if they are not original or CC0 licensed.
  "
}

match level/tiled/**/*.{tmx,tsx} {
  description: "
    This is a Tiled map or tileset file for the Get Lost level.
    
    Tiled is an external map editor used to design levels:
    - .tmx files are map files
    - .tsx files are tileset files
    
    These files define the level layout, collision areas, spawn points, and other map data.
  "
} 