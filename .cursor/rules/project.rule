/**
 * General project rules
 * These rules apply to the overall Get Lost level template project
 */

match README.md {
  description: "
    Project README for the Get Lost level template.
    
    Contains:
    - Project overview and purpose
    - Setup instructions
    - Development instructions
    - Links to documentation and resources
  "
}

match scripts/**/*.sh {
  description: "
    Shell scripts for automating development tasks.
    
    Scripts include:
    - Development helpers
    - Build automation
    - Level upgrade utilities
  "
}

match * {
  description: "
    This is a file in the Get Lost level template.
    
    Get Lost is a game development platform where you can create and share levels.
    This template provides a starting point for building your own levels.
    
    Key directories:
    - level/: Contains level assets, code, and resources
    - src/: Contains the frontend code that runs the level
    - scripts/: Contains automation scripts
    
    For more information, visit the docs at https://docs.getlost.gg/latest/
  "
} 